SECRET_KEY="4238(*bp^^$mst9a7jf1-6f%@yt%v_1s$jwqhq&=q!)6gyj3#v"
DEBUG="true"
IS_PRODUCTION="false"
CORS_ALLOW_ALL_ORIGINS="false"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_HOSTS="localhost,127.0.0.1"
SERVER_URL="http://localhost:8000"
DATABASE_USERNAME="admin"
DATABASE_PASSWORD="password"
DATABASE_NAME="chatbot"
DATABASE_PORT="5432"
# IP literal, not "localhost" — Windows resolves "localhost" to ::1 first,
# and Docker only publishes this port on IPv4, so a hostname here hangs for
# a long OS-level timeout before falling back to the working IPv4 address.
LOCAL_DATABASE_HOST="127.0.0.1"
DOCKER_DATABASE_HOST="postgres"
# Channel layer (WebSocket broadcast) backend. docker-compose sets these to
# the redis service automatically; only needed here for running from source.
REDIS_HOST="localhost"
REDIS_PORT="6379"
